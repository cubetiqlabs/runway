POSTGRES_USER=runway
POSTGRES_PASSWORD=runway_dev_password
POSTGRES_DB=runway
POSTGRES_PORT=5432

RUNWAY_IMAGE=ghcr.io/cubetiqlabs/runway:latest
RUNWAY_VERSION=1.0.0
RUNWAY_APP_ENVIRONMENT=development
APP_PORT=8080

RUNWAY_SECURITY_SESSION_SECRET=change-me-in-production-min-32-characters-long
RUNWAY_SECURITY_ENCRYPTION_KEY=change-me-in-production-32-bytes-key
RUNWAY_SECURITY_COOKIE_SECURE=false
RUNWAY_SECURITY_COOKIE_SAME_SITE=Lax

RUNWAY_ADMIN_EMAIL=admin@runway.local
RUNWAY_ADMIN_PASSWORD=RunwayAdmin123!

RUNWAY_GITHUB_APP_ID=0
RUNWAY_GITHUB_APP_SLUG=runway
RUNWAY_GITHUB_WEBHOOK_SECRET=
RUNWAY_GITHUB_PRIVATE_KEY_PEM=
RUNWAY_ORCHESTRATOR_PROVIDER=simulated
RUNWAY_ORCHESTRATOR_DOCKER_SOCKET=tcp://docker-proxy:2375
RUNWAY_ORCHESTRATOR_DEFAULT_IMAGE=ghcr.io/actions/actions-runner:latest
RUNWAY_ORCHESTRATOR_RUNNER_DOCKER_HOST=tcp://runner-dind:2375
RUNWAY_RUNNER_NETWORK=runway-runner-net
BACKUP_RETENTION_DAYS=14
